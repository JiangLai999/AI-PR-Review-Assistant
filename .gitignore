# Local project secrets
.ai_pr_review/config.json
.ai_pr_review/config.local.json
# Local fallback result store (SQLite + WAL) when the per-user path is unwritable
.ai_pr_review/results.db
.ai_pr_review/results.db-shm
.ai_pr_review/results.db-wal

# Python cache and test artifacts
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
# Sandbox-friendly TEMP dirs used when the default temp path is not writable
.pytest_x/
.pytest_codex/
# Per-agent TEMP dirs used by scripts/agent_dispatch_runner.py
.pytest_claude/
.pytest_mimo/
# Agent bus run logs (belt-and-braces: the bus has its own .gitignore too)
.agent-bus/runs/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Local runtime data
*.db
*.sqlite
*.sqlite3

# Frontend toolchain (web/)
# 注意：src/ai_pr_review/web_static/ 是构建产物，但需要提交——
# 它是随包分发的界面资源，使 `pip install` 之后无需 Node 即可运行 pr-review serve。
web/node_modules/
web/.npm-cache/
web/.vite/
web/.shots/
.distcheck/

# OpenTUI frontend build output. The small staged bundle lives in
# src/ai_pr_review/tui_static/ and is committed so `pip install` can run the
# TUI with Bun; the ~90 MB compiled single-file binary stays local.
frontend/tui/dist/
# Frontend toolchain dependencies. The only payload that ships is the staged
# copy under src/ai_pr_review/tui_static/, which IS committed.
frontend/tui/node_modules/
src/ai_pr_review/tui_static/pr-review-tui
src/ai_pr_review/tui_static/pr-review-tui.exe

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local P5 installation and frame captures
_p5_verify/

# Raw transcripts from delegated agent CLIs
_agent_out/
