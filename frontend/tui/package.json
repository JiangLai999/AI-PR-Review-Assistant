{
  "name": "ai-pr-review-tui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --preload @opentui/solid/preload src/main.tsx",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build-tui.ts",
    "stage": "bun run scripts/build-tui.ts --js-only --stage",
    "test": "bun test src",
    "terminal-check": "bun --preload @opentui/solid/preload scripts/manual-terminal-check.tsx"
  },
  "dependencies": {
    "@opentui/core": "0.1.101",
    "@opentui/solid": "0.1.101",
    "solid-js": "1.9.11"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.2"
  }
}




